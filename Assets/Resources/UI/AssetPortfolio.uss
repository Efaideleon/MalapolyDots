.portfolio-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; }
.portfolio-root.is-open { display: flex; }
.portfolio-shade { flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(5, 19, 33, 0.88); }
.portfolio-card {
    width: 92%; max-width: 1450px; height: 90%;
    background-color: rgb(17, 67, 76); color: rgb(255, 249, 224);
    border-width: 5px; border-color: rgb(255, 211, 92); border-bottom-width: 12px; border-bottom-color: rgb(170, 111, 35);
    border-radius: 30px; padding: 22px;
    -unity-font: url("project://database/Assets/Resources/Fonts/Acme-Regular.ttf"); -unity-font-definition: url("project://database/Assets/Resources/Fonts/Acme-Regular%20SDF.asset?fileID=11400000&guid=545e42076256d47e68fbb6af37b1afdc&type=2"); font-size: 26px;
}
.portfolio-heading {
    flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0;
    background-color: rgb(26, 103, 111); border-width: 3px; border-color: rgb(68, 158, 160);
    border-bottom-width: 6px; border-bottom-color: rgb(8, 47, 60); border-radius: 21px;
    padding: 12px 16px; margin-bottom: 14px;
}
.portfolio-coin {
    width: 64px; height: 64px; flex-shrink: 0; margin-right: 16px;
    background-color: rgb(255, 216, 91); color: rgb(121, 70, 21);
    border-width: 3px; border-color: rgb(255, 242, 175); border-bottom-width: 6px; border-bottom-color: rgb(185, 122, 32);
    border-radius: 32px; font-size: 43px; -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular.ttf"); -unity-font-definition: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular%20SDF.asset?fileID=11400000&guid=6fc596bdedf0c431788d92bdb4136c7a&type=2");
}
.portfolio-heading-copy { flex-grow: 1; margin-right: 16px; }
.portfolio-kicker { font-size: 20px; color: rgb(161, 239, 216); letter-spacing: 2px; }
.portfolio-title {
    font-size: 52px; color: rgb(255, 226, 120); white-space: normal;
    -unity-font: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular.ttf"); -unity-font-definition: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular%20SDF.asset?fileID=11400000&guid=6fc596bdedf0c431788d92bdb4136c7a&type=2");
}
.portfolio-cash {
    font-size: 32px; color: rgb(25, 76, 50); background-color: rgb(186, 243, 154); flex-shrink: 0;
    border-width: 3px; border-color: rgb(224, 255, 184); border-bottom-width: 6px; border-bottom-color: rgb(83, 153, 82);
    border-radius: 16px; padding: 9px 16px; margin-right: 12px;
}
.portfolio-summary {
    font-size: 26px; white-space: normal; flex-shrink: 0; padding: 9px 16px;
    color: rgb(255, 241, 189); background-color: rgb(10, 47, 59); border-radius: 14px;
}
.portfolio-help { white-space: normal; color: rgb(209, 234, 228); font-size: 22px; margin-top: 8px; margin-bottom: 8px; }
.portfolio-legend { white-space: normal; color: rgb(199, 232, 219); font-size: 22px; margin: 8px 4px 4px; flex-shrink: 0; }
.portfolio-status { white-space: normal; color: rgb(255, 221, 113); font-size: 24px; min-height: 30px; flex-shrink: 0; margin-left: 4px; }
.portfolio-scroll { flex-grow: 1; min-height: 0; }
.portfolio-rules { flex-shrink: 0; margin: 0 0 16px; padding: 8px 12px; background-color: rgb(24, 83, 91); border-radius: 14px; }
.portfolio-rules > .unity-toggle { min-height: 42px; }
.portfolio-rules .unity-toggle__text { color: rgb(255, 226, 133); font-size: 24px; }
.portfolio-rules .unity-toggle__checkmark { -unity-background-image-tint-color: rgb(255, 226, 133); }
.portfolio-rules .unity-foldout__content { margin-left: 12px; }
.portfolio-row { background-color: rgb(26, 92, 101); border-radius: 16px; padding: 16px; margin-bottom: 14px; flex-shrink: 0; }
.portfolio-property-name { font-size: 30px; -unity-font-style: bold; white-space: normal; }
.portfolio-details { color: rgb(209, 234, 228); font-size: 24px; white-space: normal; margin-bottom: 8px; }
.portfolio-actions { flex-direction: row; flex-wrap: wrap; align-items: center; }
.portfolio-card Button {
    min-height: 58px; padding: 9px 16px; background-image: none;
    background-color: rgb(62, 188, 142); color: rgb(9, 60, 49);
    border-width: 3px; border-color: rgb(143, 243, 185); border-bottom-width: 7px; border-bottom-color: rgb(16, 103, 77);
    border-radius: 13px; font-size: 26px; margin: 4px; white-space: normal;
    -unity-font: url("project://database/Assets/Resources/Fonts/Acme-Regular.ttf"); -unity-font-definition: url("project://database/Assets/Resources/Fonts/Acme-Regular%20SDF.asset?fileID=11400000&guid=545e42076256d47e68fbb6af37b1afdc&type=2"); transition-duration: 0.12s;
}
.portfolio-card Button:hover:enabled { background-color: rgb(109, 223, 163); border-top-color: rgb(220, 255, 207); translate: 0 -2px; }
.portfolio-card Button:active:enabled { background-color: rgb(41, 161, 120); border-bottom-width: 3px; translate: 0 2px; }
.portfolio-card Button:focus { border-color: rgb(255, 240, 163); }
.portfolio-card Button:disabled { opacity: 0.48; }
.portfolio-card .portfolio-close {
    flex-shrink: 0; background-color: rgb(255, 205, 100); color: rgb(88, 48, 23);
    border-color: rgb(255, 239, 164); border-bottom-color: rgb(184, 116, 37); font-size: 24px;
}
.portfolio-card .portfolio-close:hover:enabled { background-color: rgb(255, 228, 140); }
.portfolio-card .portfolio-close:active:enabled { background-color: rgb(239, 184, 76); }
.portfolio-actions .unity-base-field { min-width: 155px; margin: 4px; font-size: 24px; }
.portfolio-actions .unity-base-text-field__input { min-height: 44px; font-size: 24px; color: rgb(79, 53, 38); }
.portfolio-actions .unity-base-field__label { min-width: 78px; color: rgb(209, 234, 228); font-size: 23px; }
.portfolio-actions .unity-base-field__input { min-width: 110px; font-size: 24px; }
.portfolio-offer { border-width: 3px; border-color: rgb(255, 217, 112); border-left-width: 8px; }

.portfolio-group {
    margin-bottom: 20px; flex-shrink: 0; padding: 14px 16px;
    background-color: rgb(22, 81, 88); border-width: 2px; border-color: rgb(45, 113, 118); border-radius: 22px;
}
.portfolio-group-heading { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
.portfolio-group-name { flex-grow: 1; font-size: 32px; color: rgb(255, 237, 182); -unity-font: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular.ttf"); -unity-font-definition: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular%20SDF.asset?fileID=11400000&guid=6fc596bdedf0c431788d92bdb4136c7a&type=2"); }
.portfolio-group-count {
    font-size: 22px; color: rgb(255, 235, 173); background-color: rgb(9, 48, 60);
    border-width: 2px; border-color: rgb(59, 129, 132); border-radius: 14px; padding: 6px 12px;
}
.portfolio-set-banner {
    flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0;
    background-color: rgb(255, 218, 111); border-width: 3px; border-bottom-width: 6px; border-color: rgb(186, 128, 40);
    border-top-color: rgb(255, 243, 171); border-radius: 14px; padding: 10px 16px; margin-bottom: 12px;
}
.portfolio-set-title { flex-grow: 1; color: rgb(75, 44, 17); font-size: 29px; white-space: normal; margin-right: 12px; -unity-font: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular.ttf"); -unity-font-definition: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular%20SDF.asset?fileID=11400000&guid=6fc596bdedf0c431788d92bdb4136c7a&type=2"); }
.portfolio-set-owner { color: rgb(84, 57, 24); font-size: 23px; white-space: normal; }
.portfolio-group-strip { flex-shrink: 0; }
.portfolio-group-strip .unity-scroll-view__content-container { flex-direction: row; align-items: flex-start; padding-bottom: 14px; padding-top: 4px; }
.portfolio-card-frame { position: relative; width: 326px; flex-shrink: 0; margin-right: 18px; padding-right: 7px; padding-bottom: 10px; }
.portfolio-card-shadow { position: absolute; left: 7px; right: 0; top: 10px; bottom: 0; background-color: rgba(3, 28, 35, 0.75); border-radius: 20px; }
.portfolio-property-card {
    flex-shrink: 0; background-color: rgb(255, 249, 228); color: rgb(79, 53, 38);
    border-width: 4px; border-color: rgb(214, 176, 104); border-bottom-width: 7px; border-radius: 20px; overflow: hidden;
}
.portfolio-property-card.is-owned { border-color: rgb(255, 203, 85); }
.is-complete-set .portfolio-property-card { border-color: rgb(255, 211, 102); }
.portfolio-property-card.is-owned:hover { border-color: rgb(255, 233, 145); background-color: rgb(255, 253, 241); }
.portfolio-property-card.is-unowned { background-color: rgb(189, 202, 185); border-color: rgb(127, 159, 147); }
.portfolio-card-face { padding: 14px 16px; }
.is-unowned .portfolio-card-face { opacity: 0.78; }
.portfolio-property-picture {
    height: 164px; align-self: stretch; margin-bottom: 14px; padding: 10px;
    background-color: rgb(248, 231, 184); border-radius: 14px; border-width: 2px; border-color: rgb(235, 204, 139);
}
.portfolio-property-card .portfolio-property-name {
    font-size: 28px; min-height: 72px; color: rgb(74, 46, 34); -unity-font-style: normal;
    -unity-text-align: middle-center; -unity-font: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular.ttf"); -unity-font-definition: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular%20SDF.asset?fileID=11400000&guid=6fc596bdedf0c431788d92bdb4136c7a&type=2");
}
.portfolio-property-card .portfolio-details { font-size: 24px; color: rgb(104, 74, 39); margin-bottom: 6px; -unity-text-align: middle-center; }
.portfolio-ownership {
    font-size: 21px; white-space: normal; min-height: 38px; color: rgb(29, 90, 51);
    background-color: rgb(199, 239, 167); border-width: 2px; border-color: rgb(141, 199, 109);
    border-radius: 11px; padding: 6px 10px; margin-bottom: 10px; -unity-text-align: middle-center;
}
.is-unowned .portfolio-ownership { color: rgb(51, 75, 62); background-color: rgb(165, 190, 164); border-color: rgb(134, 162, 137); }
.portfolio-color-band { height: 34px; flex-shrink: 0; border-bottom-width: 4px; border-bottom-color: rgba(74, 46, 34, 0.2); }
.group-1 .portfolio-color-band { background-color: rgb(232, 231, 220); }
.group-2 .portfolio-color-band { background-color: rgb(158, 99, 62); }
.group-3 .portfolio-color-band { background-color: rgb(108, 205, 243); }
.group-4 .portfolio-color-band { background-color: rgb(179, 96, 204); }
.group-5 .portfolio-color-band { background-color: rgb(255, 153, 55); }
.group-6 .portfolio-color-band { background-color: rgb(235, 76, 82); }
.group-7 .portfolio-color-band { background-color: rgb(246, 212, 66); }
.group-8 .portfolio-color-band { background-color: rgb(65, 185, 116); }
.group-9 .portfolio-color-band { background-color: rgb(72, 120, 230); }
.group-10 .portfolio-color-band { background-color: rgb(151, 165, 183); }
.group-11 .portfolio-color-band { background-color: rgb(95, 213, 197); }
.is-unowned .portfolio-color-band { opacity: 0.6; }
.portfolio-management {
    padding: 10px 12px; margin: 0; background-color: rgb(248, 233, 195);
    border-top-width: 3px; border-top-color: rgb(228, 196, 135); color: rgb(79, 53, 38); font-size: 24px;
}
.portfolio-management > .unity-toggle { min-height: 50px; }
.portfolio-management .unity-toggle__text { color: rgb(96, 61, 27); font-size: 24px; }
.portfolio-management .unity-toggle__checkmark { -unity-background-image-tint-color: rgb(96, 61, 27); }
.portfolio-management .unity-foldout__content { margin-left: 0; min-width: 0; }
.portfolio-management .portfolio-actions { flex-direction: column; flex-wrap: nowrap; align-items: stretch; flex-shrink: 0; min-width: 0; width: 100%; }
.portfolio-management Button { width: 100%; min-width: 0; max-width: 100%; height: auto; flex-shrink: 0; font-size: 24px; margin: 5px 0; padding: 10px; }
.portfolio-management .portfolio-help { font-size: 21px; color: rgb(112, 78, 41); }
.portfolio-management .unity-base-field { flex-direction: column; min-width: 0; margin: 6px 0; }
.portfolio-management .unity-base-field__input {
    min-width: 0; min-height: 48px; padding: 6px 10px; background-color: rgb(255, 253, 240);
    border-width: 2px; border-color: rgb(200, 158, 93); border-radius: 10px; color: rgb(79, 53, 38); font-size: 24px;
}
.portfolio-management .unity-base-field__input:focus { border-color: rgb(20, 145, 125); }
.portfolio-management .unity-base-field__label { min-width: 0; margin-bottom: 5px; color: rgb(100, 65, 30); font-size: 23px; }
.portfolio-management .unity-base-text-field__input { color: rgb(79, 53, 38); font-size: 24px; }
.portfolio-management .unity-base-popup-field__text { color: rgb(79, 53, 38); font-size: 24px; }
.portfolio-management .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(96, 61, 27); }

.portfolio-card .unity-scroller { background-color: rgb(9, 43, 54); border-radius: 14px; padding: 3px; }
.portfolio-card .unity-scroller--vertical { width: 28px; min-width: 28px; margin-left: 12px; }
.portfolio-card .unity-scroller--horizontal { height: 26px; min-height: 26px; margin-top: 8px; }
.portfolio-card .unity-scroller__low-button, .portfolio-card .unity-scroller__high-button { display: none; }
.portfolio-card .unity-scroller .unity-base-slider { margin: 0; flex-grow: 1; }
.portfolio-card .unity-scroller--vertical .unity-base-slider { width: 22px; min-width: 22px; border-width: 0; padding: 0; }
.portfolio-card .unity-scroller--horizontal .unity-base-slider { height: 20px; min-height: 20px; border-width: 0; padding: 0; }
.portfolio-card .unity-scroller .unity-base-slider__tracker { background-color: rgb(5, 32, 43); border-radius: 11px; }
.portfolio-card .unity-scroller .unity-base-slider__dragger { background-color: rgb(255, 205, 87); border-width: 2px; border-color: rgb(255, 238, 153); border-radius: 11px; }
.portfolio-card .unity-scroller .unity-base-slider__dragger:hover { background-color: rgb(255, 229, 129); }
.portfolio-card .unity-scroller .unity-base-slider__dragger:active { background-color: rgb(230, 164, 47); }
.portfolio-card .unity-scroller .unity-base-slider__dragger-border { border-width: 0; background-color: transparent; }
.portfolio-card .unity-scroller--vertical .unity-base-slider__tracker { width: 18px; }
.portfolio-card .unity-scroller--vertical .unity-base-slider__dragger { width: 22px; min-width: 22px; min-height: 48px; }
.portfolio-card .unity-scroller--horizontal .unity-base-slider__tracker { height: 16px; }
.portfolio-card .unity-scroller--horizontal .unity-base-slider__dragger { height: 20px; min-height: 20px; min-width: 48px; }

.portfolio-debt-banner { display: none; flex-shrink: 0; background-color: rgb(255, 221, 130); border-width: 2px; border-color: rgb(191, 139, 50); border-bottom-width: 5px; border-radius: 15px; padding: 10px 16px; margin-top: 10px; }
.is-in-debt .portfolio-debt-banner { display: flex; }
.portfolio-debt-title { color: rgb(86, 48, 24); font-size: 28px; -unity-font-definition: url("project://database/Assets/Resources/Fonts/LuckiestGuy-Regular%20SDF.asset?fileID=11400000&guid=6fc596bdedf0c431788d92bdb4136c7a&type=2"); }
.portfolio-debt-help { color: rgb(86, 48, 24); font-size: 22px; white-space: normal; margin-top: 4px; }
.is-in-debt .portfolio-cash { background-color: rgb(255, 190, 153); color: rgb(105, 43, 27); border-color: rgb(255, 222, 176); border-bottom-color: rgb(176, 93, 59); }
.portfolio-footer { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; padding-top: 10px; }
.portfolio-footer-help { flex-grow: 1; font-size: 20px; color: rgb(199, 232, 219); white-space: normal; margin-right: 12px; }
.portfolio-card .portfolio-bankruptcy-button { background-color: rgb(244, 143, 119); color: rgb(90, 35, 29); border-color: rgb(255, 204, 162); border-bottom-color: rgb(151, 64, 48); font-size: 23px; }
.portfolio-card .portfolio-bankruptcy-button:hover:enabled { background-color: rgb(255, 171, 143); }
.portfolio-card .portfolio-bankruptcy-button:active:enabled { background-color: rgb(224, 114, 96); }
.portfolio-management .portfolio-bank-sale { background-color: rgb(255, 205, 100); color: rgb(88, 48, 23); border-color: rgb(255, 239, 164); border-bottom-color: rgb(184, 116, 37); }
.portfolio-management .portfolio-bank-sale:hover:enabled { background-color: rgb(255, 228, 140); }
.portfolio-management .portfolio-bank-sale:active:enabled { background-color: rgb(239, 184, 76); }
.portfolio-bankruptcy-confirmation { display: none; position: absolute; left: 12px; right: 12px; top: 12px; bottom: 12px; padding: 32px; background-color: rgba(17, 67, 76, 0.98); border-width: 4px; border-color: rgb(244, 143, 119); border-radius: 22px; justify-content: center; align-items: center; }
.portfolio-bankruptcy-confirmation.is-visible { display: flex; }
.portfolio-bankruptcy-confirmation > .portfolio-help { font-size: 30px; color: rgb(255, 249, 224); max-width: 760px; -unity-text-align: middle-center; margin-bottom: 24px; }

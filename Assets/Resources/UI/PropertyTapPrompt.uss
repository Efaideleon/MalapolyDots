.property-tap-layer { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.property-tap-prompt {
    position: absolute; width: 200px; align-items: center; padding: 8px 12px;
    background-color: rgba(9, 43, 54, 0.96); border-width: 2px; border-color: rgb(217, 251, 255);
    border-bottom-width: 5px; border-bottom-color: rgb(68, 158, 160); border-radius: 18px;
}
.property-tap-prompt.is-hidden { display: none; }
.property-tap-hand { width: 48px; height: 48px; }
.property-tap-hand-icon { flex-grow: 1; }
.game-ui .property-tap-caption { font-size: 24px; color: rgb(217, 251, 255); -unity-text-align: middle-center; }

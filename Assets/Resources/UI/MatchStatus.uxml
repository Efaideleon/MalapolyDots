<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="GameTheme.uss" />
    <ui:Style src="MatchStatus.uss"/>
    <ui:VisualElement name="matchStatus" class="match-status game-ui" picking-mode="Ignore">
        <ui:VisualElement name="turnCard" class="match-turn" picking-mode="Ignore">
            <ui:VisualElement class="match-turn-heading" picking-mode="Ignore">
                <ui:Label name="turnSummary" class="match-turn-title" picking-mode="Ignore"/>
                <ui:Label name="roundSummary" class="match-round-label" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:Label name="turnHint" class="match-turn-hint" picking-mode="Ignore"/>
            <ui:Label name="propertyTapHint" class="match-property-tap-hint" picking-mode="Ignore"/>
            <ui:VisualElement name="roundProgress" class="match-round-progress" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="results" class="match-results">
            <ui:VisualElement class="match-results-card">
                <ui:Label name="resultEyebrow" text="MALAPOLY / FINAL RESULTS" class="match-eyebrow"/>
                <ui:Label name="resultTitle" class="match-result-title"/>
                <ui:Label name="resultReason" class="match-reason"/>
                <ui:VisualElement name="standingsHeader" class="match-standings-heading">
                    <ui:Label text="THE FINAL STANDINGS" class="match-eyebrow"/>
                    <ui:Label text="NET WORTH" class="match-eyebrow"/>
                </ui:VisualElement>
                <ui:ScrollView name="standings" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="match-standings"/>
                <ui:Label name="worthNote" text="Net worth includes cash, properties, and buildings." class="match-worth-note"/>
                <ui:Button name="returnToMenu" text="Return to main menu" class="match-return"/>
                <ui:Label name="returnStatus" class="match-reason"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

.card-hand-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.cards-trigger {
    position: absolute; top: auto; right: 5%; bottom: 12%; flex-direction: row; align-items: center;
    min-width: 230px; height: 76px; padding: 10px 18px; border-width: 3px;
    border-color: rgb(255, 213, 103); border-bottom-width: 7px; border-bottom-color: rgb(139, 87, 37);
    border-radius: 18px; background-color: rgb(37, 74, 81);
}
.cards-trigger:hover { background-color: rgb(48, 96, 100); }
.cards-trigger-stack { position: relative; width: 48px; height: 48px; margin-right: 12px; }
.cards-stack-back, .cards-stack-front { position: absolute; width: 31px; height: 42px; border-width: 2px; border-radius: 5px; }
.cards-stack-back { left: 12px; top: 1px; rotate: 10deg; background-color: rgb(210, 97, 61); border-color: rgb(255, 222, 151); }
.cards-stack-front { left: 2px; top: 5px; rotate: -9deg; background-color: rgb(248, 220, 151); border-color: rgb(255, 246, 213); }
.cards-trigger-title { color: rgb(255, 224, 143); font-size: 30px; -unity-font-style: bold; }
.cards-trigger-count { margin-left: auto; color: rgb(221, 246, 228); font-size: 27px; -unity-font-style: bold; }
.cards-trigger.is-hidden { display: none; }
.cards-modal-shade { display: none; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(5, 19, 33, 0.68); }
.cards-modal-shade.is-active { display: flex; }
.cards-panel {
    display: none; position: absolute; top: 50%; right: auto; bottom: auto; left: 50%; width: 98%; max-width: 1300px;
    translate: -50% -50%; flex-direction: column; align-items: stretch; padding: 0;
}
.card-hand-overlay.is-open .cards-panel { display: flex; }
.cards-panel-header { position: relative; height: 116px; margin-bottom: 8px; }
.cards-panel-title { position: absolute; top: 0; left: 50%; translate: -50% 0; color: rgb(255, 213, 103); font-size: 42px; -unity-font-style: bold; white-space: nowrap; }
.cards-panel-count { position: absolute; bottom: 0; left: 50%; translate: -50% 0; color: rgb(172, 231, 199); font-size: 28px; letter-spacing: 1px; }
.cards-close { position: absolute; top: 0; right: 0; width: 84px; height: 84px; padding: 0; color: rgb(255, 232, 195); font-size: 42px; border-width: 3px; border-color: rgb(93, 142, 143); border-radius: 18px; background-color: rgb(31, 76, 82); }
.cards-close.is-hidden { display: none; }
.cards-list { align-self: center; flex-direction: row; align-items: flex-end; justify-content: center; width: 100%; height: 420px; padding: 0 20px 12px; overflow: visible; }
.inventory-card {
    flex-shrink: 0; width: 300px; height: 380px; margin-right: -95px; padding: 0;
    border-width: 0; border-radius: 0; background-image: none; background-color: rgba(0, 0, 0, 0);
}
.inventory-card-fan-0 { rotate: -8deg; translate: 0 24px; }
.inventory-card-fan-1 { rotate: -3deg; translate: 0 6px; }
.inventory-card-fan-2 { rotate: 3deg; translate: 0 6px; }
.inventory-card-fan-3 { rotate: 8deg; translate: 0 24px; margin-right: 0; }
.inventory-card-visual {
    flex-direction: column; align-items: stretch; width: 100%; height: 100%; padding: 18px;
    border-width: 3px; border-color: rgb(255, 235, 174); border-bottom-width: 8px; border-bottom-color: rgb(126, 82, 39);
    border-radius: 20px; background-image: none; background-color: rgb(247, 225, 169); color: rgb(67, 55, 42); white-space: normal;
    transform-origin: bottom center; transition-duration: 0.16s;
}
.inventory-card:hover .inventory-card-visual { translate: 0 -30px; background-color: rgb(255, 246, 215); border-color: rgb(255, 250, 220); }
.inventory-card.is-playing .inventory-card-visual { translate: 0 -110px; opacity: 0; transition-duration: 0.2s; }
.inventory-card-topline { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.inventory-card-ribbon { color: rgb(157, 83, 49); font-size: 18px; letter-spacing: 1px; -unity-font-style: bold; }
.inventory-card-slot { color: rgb(106, 92, 67); font-size: 18px; }
.inventory-card-title { color: rgb(85, 51, 34); font-size: 30px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.inventory-card-description { margin-top: 18px; color: rgb(80, 72, 58); font-size: 23px; white-space: normal; -unity-text-align: middle-center; }
.inventory-card-condition { margin-top: auto; padding-top: 12px; color: rgb(115, 77, 45); font-size: 21px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.cards-empty { align-self: center; padding: 24px 12px; color: rgb(199, 232, 219); font-size: 26px; -unity-text-align: middle-center; white-space: normal; }
.cards-discard-new { display: none; min-height: 72px; margin-top: 10px; color: rgb(255, 234, 221); font-size: 25px; -unity-font-style: bold; border-width: 3px; border-color: rgb(217, 151, 117); border-bottom-width: 5px; border-bottom-color: rgb(116, 57, 48); border-radius: 14px; background-color: rgb(137, 62, 51); }
.cards-discard-new.is-visible { display: flex; }

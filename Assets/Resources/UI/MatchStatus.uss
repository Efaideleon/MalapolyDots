.match-status { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.match-turn { align-self: center; margin-top: 16px; padding: 12px 24px; border-radius: 12px; background-color: rgba(17, 38, 62, 0.92); color: rgb(255, 248, 226); font-size: 24px; white-space: normal; }
.match-results { display: none; position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(9, 22, 37, 0.90); align-items: center; justify-content: center; }
.match-results.is-visible { display: flex; }
.match-results-card { width: 760px; max-width: 94%; padding: 32px; border-radius: 24px; border-width: 2px; border-color: rgb(82, 124, 150); background-color: rgb(28, 55, 79); }
.match-results-card Label { white-space: normal; color: rgb(237, 242, 242); font-size: 23px; }
.match-results-card .match-eyebrow { font-size: 19px; color: rgb(242, 196, 106); }
.match-results-card .match-result-title { font-size: 44px; -unity-font-style: bold; margin: 10px 0; }
.match-results-card .match-reason { color: rgb(184, 205, 221); font-size: 20px; margin: 8px 0; }
.match-standings { margin: 16px 0; padding: 12px; background-color: rgb(17, 38, 62); border-radius: 12px; }
.match-standing { padding: 8px; }
.match-return { min-height: 60px; margin-top: 16px; background-color: rgb(34, 113, 127); color: white; border-width: 1px; border-color: rgb(79, 151, 166); border-radius: 10px; font-size: 24px; }
.match-return:hover { background-color: rgb(43, 138, 151); }

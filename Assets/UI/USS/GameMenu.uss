button {
    background-color: rgb(255, 215, 0);
    color: white;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 18px;
    text-align: center;
}

.button-player-choose:hover Label {
    background-color: rgb(255, 255, 0);
}

.button-player-choose:active Label {
    background-color: rgb(184, 88, 243);
}

.button-player-choose > Label {
    background-color: rgb(255, 204, 1);
    margin: 0;
    width: 100%;
    height: 92%;
    border-radius: 15px;
    border-bottom-width: 1px;
    border-top-width: 1px;
    border-bottom-color: rgb(255, 236, 59);
    border-top-color: rgb(255, 255, 0);
}

.button-player-choose > #highlight {
    background-color: rgb(255, 236, 59);
}

.button-player-choose > #shadow {
    background-color: rgb(238, 130, 0);
}

.char-picked-btn-container {
    margin: 10px;
    align-items: center;
    justify-content: center;
}

.char-picked-btn-container Button {
    background-color: rgb(255, 204, 1);
    color: white;
    border-radius: 10px;
    width: 180px;
    height: 180px;
    border-color: rgb(0, 0, 0);
    border-width: 5px;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
    text-align: center;
    transition: background-color 0.2s, transform 0.1s;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.char-picked-btn-container Button > .character-sprite {
    margin: 0;
    width: 100%;
    height: 92%;
    border-radius: 15px;
    background-color: rgba(244, 117, 229, 0.35);
}

.char-picked-btn-container #highlight {
    background-color: rgba(252, 161, 255, 0.35);
}

.char-picked-btn-container #shadow {
    background-color: rgb(186, 0, 179);
}

.char-picked-btn-container Button:hover > .character-sprite {
    background-color: rgba(244, 117, 229, 0.45);
}

.char-disabled-btn-container {
    margin: 10px;
    align-items: center;
    justify-content: center;
}

.char-disabled-btn-container Button {
    color: white;
    border-radius: 10px;
    width: 180px;
    height: 180px;
    border-color: rgb(0, 0, 0);
    border-width: 5px;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
    text-align: center;
    transition: background-color 0.2s, transform 0.1s;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.char-disabled-btn-container Label {
    background-color: rgb(170, 170, 170);
    margin: 0;
    width: 100%;
    height: 92%;
    border-radius: 15px;
    border-bottom-width: 1px;
    border-top-width: 1px;
    border-bottom-color: rgb(225, 225, 225);
    border-top-color: rgb(186, 186, 186);
}

.char-disabled-btn-container Button:hover Label {
    background-color: rgb(170, 170, 170);
}

.char-disabled-btn-container #highlight {
    background-color: rgb(209, 209, 209);
}

.char-disabled-btn-container {
    margin: 10px;
    align-items: center;
    justify-content: center;
}

.char-disabled-btn-container #shadow {
    background-color: rgb(92, 92, 92);
}

.char-not-picked-btn-container {
    margin: 10px;
    align-items: center;
    justify-content: center;
}

.char-not-picked-btn-container Button {
    background-color: rgb(255, 204, 1);
    color: white;
    border-radius: 10px;
    width: 180px;
    height: 180px;
    border-color: rgb(0, 0, 0);
    border-width: 5px;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
    text-align: center;
    transition: background-color 0.2s, transform 0.1s;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.char-not-picked-btn-container Button > .character-sprite {
    background-color: rgb(255, 204, 1);
    border-bottom-width: 1px;
    border-top-width: 1px;
    border-bottom-color: rgb(255, 236, 59);
    border-top-color: rgb(255, 255, 0);
}

.char-not-picked-btn-container Button:hover > .character-sprite {
    background-color: rgb(255, 255, 0);
}

.char-not-picked-btn-container Button:active > .character-sprite {
    background-color: rgb(184, 88, 243);
    border-color: rgb(184, 88, 243);
}

.char-not-picked-btn-container Button:active #highlight {
    background-color: rgb(238, 128, 255);
}

.char-not-picked-btn-container Button:active #shadow {
    background-color: rgb(110, 29, 170);
}

.char-not-picked-btn-container #highlight {
    background-color: rgb(255, 236, 59);
}

.char-not-picked-btn-container #shadow {
    background-color: rgb(238, 130, 0);
}

.medium-panel {
    width: 512px;
    height: 512px;
    border-radius: 25px;
    border-width: 5px;
    border-color: rgb(215, 75, 231);
}

.char-picked-btn-container Button,
.char-locked-in-btn-container Button,
.char-not-picked-btn-container Button {
    position: relative;
}

.character-sprite {
    position: absolute;
    top: 4%;
    left: 0;
    margin: 0;
    width: 100%;
    height: 92%;
    border-radius: 15px;
}

.char-locked-in-btn-container {
    margin: 10px;
    align-items: center;
    justify-content: center;
}

.game-menu .char-locked-in-btn-container Button {
    background-color: rgba(62, 188, 142, 0.35);
    border-color: rgb(0, 0, 0);
    border-width: 5px;
    width: 180px;
    height: 180px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
}

.char-locked-in-btn-container Button > .character-sprite {
    background-color: rgba(62, 188, 142, 0.35);
}

.game-menu .char-locked-in-btn-container Button:disabled {
    opacity: 1;
}

.game-menu .char-not-picked-btn-container,
.game-menu .char-picked-btn-container,
.game-menu .char-locked-in-btn-container {
    position: relative;
    width: 180px;
    height: 180px;
    min-width: 180px;
    min-height: 180px;
    max-width: 180px;
    max-height: 180px;
    margin: 10px;
    padding: 0;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.game-menu .char-not-picked-btn-container Button,
.game-menu .char-picked-btn-container Button,
.game-menu .char-locked-in-btn-container Button {
    position: absolute;
    top: 0;
    left: 0;
}

.game-menu .char-not-picked-btn-container Button,
.game-menu .char-picked-btn-container Button,
.game-menu .char-locked-in-btn-container Button {
    width: 180px;
    height: 180px;
    min-width: 180px;
    min-height: 180px;
    max-width: 180px;
    max-height: 180px;
    margin: 0;
    padding: 0;
    border-width: 5px;
    border-radius: 20px;
    flex-shrink: 0;
}

.blur-shadow {
    position: absolute;
    top: 0;
    width: 130%;
    height: 130%;
    background-image: url("project://database/Assets/Textures/shadow_sprite_200px.png?fileID=21300000&guid=9c99d9ad068e72b4c89eaa3245f7a980&type=3#shadow_sprite_200px");
}

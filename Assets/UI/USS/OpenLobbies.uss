.lobby-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(17, 38, 62);
    color: rgb(242, 239, 225);
}
.lobby-page-scroll { flex-grow: 1; }
.lobby-page {
    width: 1200px;
    max-width: 96%;
    align-self: center;
    padding: 32px 24px;
}
.lobby-topbar { flex-direction: row; align-items: center; margin-bottom: 22px; }
.lobby-screen .lobby-eyebrow { color: rgb(236, 190, 97); font-size: 20px; margin-left: 20px; }
.lobby-screen .lobby-title { font-size: 52px; -unity-font-style: bold; color: rgb(255, 248, 226); white-space: normal; }
.lobby-screen .lobby-subtitle { font-size: 24px; color: rgb(184, 205, 221); margin-top: 6px; margin-bottom: 28px; white-space: normal; }
.lobby-columns { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.lobby-primary { width: 660px; max-width: 100%; flex-grow: 1; margin-right: 20px; margin-bottom: 20px; }
.lobby-card {
    padding: 28px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgb(68, 99, 123);
    background-color: rgb(28, 55, 79);
}
.lobby-members { width: 410px; max-width: 100%; flex-grow: 1; margin-bottom: 20px; }
.lobby-screen Label { color: rgb(237, 242, 242); font-size: 22px; white-space: normal; }
.lobby-screen .lobby-section-title { color: rgb(242, 196, 106); font-size: 25px; -unity-font-style: bold; }
.lobby-screen .lobby-caption { font-size: 20px; color: rgb(171, 198, 217); margin-top: 4px; margin-bottom: 24px; }
.lobby-screen .lobby-help { font-size: 20px; color: rgb(171, 198, 217); margin-top: 16px; margin-bottom: 16px; }
.lobby-screen .lobby-footer { font-size: 17px; color: rgb(148, 177, 197); margin-top: 8px; }
.lobby-screen .unity-button {
    min-height: 54px;
    min-width: 0;
    height: auto;
    padding: 10px 18px;
    margin: 0;
    border-width: 1px;
    border-color: rgb(79, 151, 166);
    border-radius: 10px;
    background-color: rgb(34, 113, 127);
    background-image: none;
    color: rgb(250, 253, 248);
    font-size: 22px;
    white-space: normal;
    -unity-font-style: bold;
}
.lobby-screen .unity-button:hover { background-color: rgb(43, 138, 151); }
.lobby-screen .unity-button:focus { border-color: rgb(247, 201, 109); border-width: 2px; }
.lobby-screen .unity-button:disabled { background-color: rgb(45, 69, 88); color: rgb(143, 166, 181); border-color: rgb(65, 90, 107); }
.lobby-back .unity-button { width: 68px; background-color: rgb(44, 64, 84); }
.lobby-members .malacity-modal { padding: 0; align-items: stretch; }
.lobby-members .malacity-container--vertical { align-items: stretch; }
.lobby-members .blocks-header { font-size: 25px; }
.lobby-members PlayerListViewElement { min-height: 160px; margin-top: 16px; margin-bottom: 20px; background-color: rgb(21, 44, 65); border-radius: 10px; padding: 12px; }
.lobby-screen .lobby-field-label { font-size: 20px; margin-top: 20px; margin-bottom: 8px; }
.lobby-screen .lobby-rounds { margin: 0; font-size: 22px; }
.lobby-rounds .unity-base-field__label { min-width: 210px; color: rgb(237, 242, 242); }
.lobby-screen .unity-base-field__input { background-color: rgb(17, 38, 58); border-color: rgb(79, 112, 135); border-width: 1px; border-radius: 8px; min-height: 52px; color: rgb(244, 245, 237); padding: 8px 12px; }
.lobby-screen .unity-text-field__input { font-size: 22px; }
.lobby-screen .lobby-create-fields { flex-direction: column; align-items: stretch; }
.lobby-create-fields TextField { margin: 0 0 12px 0; width: auto; }
.lobby-screen .lobby-code { margin-top: 4px; flex-wrap: wrap; }
.lobby-code TextField { flex-grow: 1; min-width: 140px; margin: 0 12px 0 0; }
.lobby-divider { height: 1px; background-color: rgb(68, 99, 123); margin-top: 22px; margin-bottom: 22px; }
.open-lobbies { flex-grow: 1; }
.lobby-screen .open-lobbies-status { font-size: 21px; color: rgb(188, 209, 223); min-height: 55px; margin-bottom: 12px; }
.open-lobbies-list { height: 290px; flex-shrink: 0; background-color: rgb(21, 44, 65); border-radius: 12px; padding: 10px; }
.lobby-screen .open-lobby-row { min-height: 72px; margin-bottom: 10px; -unity-text-align: middle-left; }
.lobby-screen .open-lobbies-refresh { margin-top: 18px; align-self: flex-start; }

.lobby-create-fields .unity-button { width: 100%; }

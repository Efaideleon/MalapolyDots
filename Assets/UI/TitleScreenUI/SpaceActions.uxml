                        <ui:VisualElement name="label-container" class="layout-space-actions-label-container-21">
                            <ui:VisualElement name="button-content" class="layout-space-actions-button-content-22">
                                <ui:VisualElement class="layout-space-actions-visualelement23-23" />
                                <ui:Label text="BUY&#10;HOTELS" class="layout-space-actions-label24-24" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="buy-property-btn-container" class="dbr-btn-with-icons dbr-btn-with-icons-yellow animation-from-bottom-initial-3 layout-space-actions-buy-property-btn-container-25">
                <ui:Button name="buy-property-button" class="button layout-space-actions-buy-property-button-26">
                    <ui:VisualElement name="blurred-shadow" class="dbr-btn layout-space-actions-blurred-shadow-27" />

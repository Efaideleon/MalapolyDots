                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="buy-hotel-btn-container" class="dbr-btn-with-icons dbr-btn-with-icons-yellow animation-from-bottom-initial-2 layout-space-actions-buy-hotel-btn-container-16">
                <ui:Button name="buy-hotel-button" class="button layout-space-actions-buy-hotel-button-17">
                    <ui:VisualElement name="blurred-shadow" class="dbr-btn layout-space-actions-blurred-shadow-18" />

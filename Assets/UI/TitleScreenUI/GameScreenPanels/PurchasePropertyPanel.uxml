<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/Panels.uss?fileID=7433441132597879392&amp;guid=82881574d3c529345996d02a565e6c15&amp;type=3#Panels" />
    <Style src="project://database/Assets/UI/USS/Buttons.uss?fileID=7433441132597879392&amp;guid=89f667ab09eb1cf4aa47c69a79f2e072&amp;type=3#Buttons" />
    <ui:Style src="project://database/Assets/Resources/UI/GameLayouts.uss" />
    <ui:Style src="project://database/Assets/Resources/UI/GameTheme.uss" />
    <ui:VisualElement name="purchase-property-container" class="panel-simple-1 game-ui game-panel layout-purchase-property-panel-purchase-property-container-4">
        <ui:VisualElement class="layout-purchase-property-panel-visualelement5-5">
            <ui:VisualElement name="property-image" class="layout-purchase-property-panel-property-image-6">
                <Bindings>
                    <ui:DataBinding property="style.backgroundImage" data-source-path="Image" data-source="project://database/Assets/UI/ScriptableObjects/PurchasePropertyPanel.asset?fileID=11400000&amp;guid=f8911d1b7c1d84b528f777896164f866&amp;type=2#PurchasePropertyPanel" binding-mode="ToTarget" />
                </Bindings>
            </ui:VisualElement>
            <ui:VisualElement class="layout-purchase-property-panel-visualelement9-9">
                <ui:VisualElement name="name-label-container" class="layout-purchase-property-panel-name-label-container-10">
                    <ui:Label text="Name Of Property" name="name-label" class="game-heading layout-purchase-property-panel-name-label-11">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="NameLabel" data-source="project://database/Assets/UI/ScriptableObjects/PurchasePropertyPanel.asset?fileID=11400000&amp;guid=f8911d1b7c1d84b528f777896164f866&amp;type=2#PurchasePropertyPanel" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="price-container" class="layout-purchase-property-panel-price-container-14">
                    <ui:Label text="price" name="price-label" class="game-details layout-purchase-property-panel-price-label-15">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="PriceLabel" data-source="project://database/Assets/UI/ScriptableObjects/PurchasePropertyPanel.asset?fileID=11400000&amp;guid=f8911d1b7c1d84b528f777896164f866&amp;type=2#PurchasePropertyPanel" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="purchase-buttons" class="layout-purchase-property-panel-purchase-buttons-18">
                    <ui:VisualElement name="purchase-btn-container" class="dbr-btn dbr-btn-blue layout-purchase-property-panel-purchase-btn-container-19">
                        <ui:Button name="purchase-button" class="button layout-purchase-property-panel-purchase-button-20">
                            <ui:VisualElement name="blurred-shadow" class="dbr-btn layout-purchase-property-panel-blurred-shadow-21" />
                            <ui:VisualElement name="gradient-border-label-container" class="layout-purchase-property-panel-gradient-border-label-container-22">
                                <ui:VisualElement name="gradient-border" class="layout-purchase-property-panel-gradient-border-23" />
                                <ui:VisualElement name="label-container" class="dbr-btn layout-purchase-property-panel-label-container-24">
                                    <ui:Label text="Purchase" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="decline-btn-container" class="dbr-btn dbr-btn-red layout-purchase-property-panel-decline-btn-container-26">
                        <ui:Button name="decline-button" class="button game-button-danger layout-purchase-property-panel-decline-button-27">
                            <ui:VisualElement name="blurred-shadow" class="dbr-btn layout-purchase-property-panel-blurred-shadow-28" />
                            <ui:VisualElement name="gradient-border-label-container" class="layout-purchase-property-panel-gradient-border-label-container-29">
                                <ui:VisualElement name="gradient-border" class="layout-purchase-property-panel-gradient-border-30" />
                                <ui:VisualElement name="label-container" class="dbr-btn layout-purchase-property-panel-label-container-31">
                                    <ui:Label text="Decline" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

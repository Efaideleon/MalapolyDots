<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../../../../UI/USS/OpenLobbies.uss"/>
    <ui:Template name="CurrentSession" src="../../../CommonSession/UI/CurrentSession.uxml"/>
    <ui:Template name="JoinSessionByCode" src="../../UI/JoinSessionByCode.uxml"/>
    <ui:VisualElement data-source="../../Settings/SessionSettings.asset?fileID=11400000&amp;guid=0bf4e1684added44da254017c7fc41b2&amp;type=2#SessionSettings" class="lobby-screen">
        <ui:ScrollView class="lobby-page-scroll">
            <ui:VisualElement class="lobby-page">
                <ui:VisualElement class="lobby-topbar">
                    <Blocks.Sessions.Common.BackToMenuButtonCodeElement class="lobby-back"><Bindings><ui:DataBinding property="SessionType" data-source-path="sessionType" binding-mode="ToTarget"/></Bindings></Blocks.Sessions.Common.BackToMenuButtonCodeElement>
                    <ui:Label text="MALAPOLY / PLAY TOGETHER" class="lobby-eyebrow"/>
                </ui:VisualElement>
                <ui:Label text="Join a public lobby" class="lobby-title"/>
                <ui:Label text="Find your table. Pick an open lobby and join without a code." class="lobby-subtitle"/>
                <ui:VisualElement class="lobby-columns">
                    <ui:Instance template="JoinSessionByCode" class="lobby-primary"/>
                    <ui:VisualElement class="lobby-card lobby-members">
                        <ui:Label text="YOUR TABLE" class="lobby-section-title"/>
                        <ui:Label text="Up to 6 players" class="lobby-caption"/>
                        <ui:Instance template="CurrentSession"/>
                        <ui:Label text="Once you join, the host starts character selection. The game begins when everyone locks in." class="lobby-help"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="CHOOSE YOUR CHARACTER  /  LOCK IN  /  LET THE GAME BEGIN" class="lobby-footer"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>

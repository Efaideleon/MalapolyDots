<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="lobby-card">
        <ui:Label text="SET UP YOUR TABLE" class="lobby-section-title"/>
        <ui:Label text="Public lobby · Up to 6 players" class="lobby-caption"/>
        <ui:DropdownField label="Number of rounds" name="NumOfRoundsDropdownField" choices="8,10,12" index="0" class="lobby-rounds"/>
        <ui:Label text="Last player standing wins, or highest net worth after the final round." class="lobby-help"/>
        <ui:Label text="Lobby name" class="lobby-field-label"/>
        <Blocks.Sessions.CreateSessionElement class="lobby-create-fields">
            <Bindings><ui:DataBinding property="SessionSettings" binding-mode="ToTarget" data-source-path=""/></Bindings>
        </Blocks.Sessions.CreateSessionElement>
        <ui:Label text="Friends can find your lobby in Join public lobby. You can also share a code." class="lobby-help"/>
        <Blocks.Sessions.Common.CopySessionCodeElement class="lobby-code"><Bindings><ui:DataBinding property="SessionType" data-source-path="sessionType" binding-mode="ToTarget"/></Bindings></Blocks.Sessions.Common.CopySessionCodeElement>
        <ui:VisualElement class="lobby-divider"/>
        <Blocks.Sessions.Common.StartGameCodeElement><Bindings><ui:DataBinding property="SessionType" data-source-path="sessionType" binding-mode="ToTarget"/></Bindings></Blocks.Sessions.Common.StartGameCodeElement>
    </ui:VisualElement>
</ui:UXML>

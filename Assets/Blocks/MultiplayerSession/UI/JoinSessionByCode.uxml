<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="lobby-card">
        <ui:Label text="OPEN LOBBIES" class="lobby-section-title"/>
        <ui:Label text="Public tables · No code required" class="lobby-caption"/>
        <Blocks.Sessions.SessionBrowserElement>
            <Bindings><ui:DataBinding property="SessionSettings" binding-mode="ToTarget" data-source-path=""/></Bindings>
        </Blocks.Sessions.SessionBrowserElement>
    </ui:VisualElement>
</ui:UXML>
